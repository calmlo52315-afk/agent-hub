{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub.runtime.skill-result",
  "title": "Skill Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "task_id",
    "skill_name",
    "version",
    "status",
    "payload",
    "metrics"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "payload": {
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "error-payload.schema.json"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "token_usage", "retry_count"],
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "token_usage": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}
