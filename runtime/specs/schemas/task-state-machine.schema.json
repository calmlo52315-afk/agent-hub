{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub.runtime.task-state-machine",
  "title": "Task State Machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "initial_state",
    "states",
    "terminal_states",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "task-state-machine"
    },
    "initial_state": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "on"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
