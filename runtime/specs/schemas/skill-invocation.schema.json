{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agenthub.runtime.skill-invocation",
  "title": "Skill Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "task_id",
    "skill_name",
    "version",
    "invoker",
    "context",
    "payload",
    "constraints"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "invoker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["orchestrator", "agent", "workflow"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_state", "shared_state_keys"],
      "properties": {
        "workflow_state": {
          "type": "string",
          "minLength": 1
        },
        "shared_state_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "payload": {
      "type": "object"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "budget_tokens", "budget_cost_usd"],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "budget_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "budget_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
